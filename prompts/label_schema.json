{
  "type": "object",
  "additionalProperties": false,
  "required": ["user_summary", "user_facing", "decisions", "rejected_findings", "message_mismatch", "confidence", "notes"],
  "properties": {
    "user_summary": {"type": "string"},
    "user_facing": {"type": "boolean"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "what", "why_it_matters", "who", "undo", "evidence", "request_quote"],
        "properties": {
          "type": {"type": "string", "enum": ["user_facing", "scope", "data_privacy", "dependency_cost", "removed_feature"]},
          "what": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "who": {"type": "string", "enum": ["asked", "implied", "agent"]},
          "undo": {"type": "string", "enum": ["easy", "hard"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "quote"],
              "properties": {"file": {"type": "string"}, "quote": {"type": "string"}}
            }
          },
          "request_quote": {"type": "string"}
        }
      }
    },
    "rejected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "file", "reason"],
        "properties": {"check": {"type": "string"}, "file": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "message_mismatch": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "notes": {"type": "string"}
  }
}
